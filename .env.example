DATABASE_URL=postgresql+psycopg://dragonflai:dragonflai_dev@localhost:5433/dragonflai
REDIS_URL=redis://localhost:6380/0

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Maximum seconds a recon job may run before RQ forcefully kills it.
# Increase for large scopes or slow networks; set to -1 for no limit.
JOB_TIMEOUT_SECONDS=3600

# Streamlit
BACKEND_URL=http://127.0.0.1:8000
UI_HOST=127.0.0.1
UI_PORT=8501

# --- LLM Configuration ------------------------------------------------------
# Select the LLM provider for AI-enhanced report generation.
# Valid values: null | ollama | openai | anthropic
# Default is "null" (AI features disabled).
LLM_PROVIDER=null

# Ollama (local, free — recommended for privacy-first setups)
# Install: https://ollama.com  then run: ollama pull llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI (cloud, paid)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic (cloud, paid)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-latest
